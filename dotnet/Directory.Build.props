<Project>
  <!-- Shared settings for every project under dotnet/. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>NewCreative</Authors>
    <Product>m365-migrate</Product>
  </PropertyGroup>
</Project>
