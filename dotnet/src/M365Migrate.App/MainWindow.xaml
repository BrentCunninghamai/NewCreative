<Window x:Class="M365Migrate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="m365-migrate — Microsoft 365 Tenant-to-Tenant Migration"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: connection + controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="m365-migrate" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Tenant-to-tenant migration" Foreground="#666" Margin="0,0,0,8" />

                <TextBlock Text="Source tenant" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Tenant ID" />
                <TextBox x:Name="SourceTenantId" />
                <TextBlock Text="App (client) ID" />
                <TextBox x:Name="SourceClientId" />
                <TextBlock Text="Client secret" />
                <PasswordBox x:Name="SourceClientSecret" />
                <TextBlock Text="Primary domain (e.g. contoso.onmicrosoft.com)" />
                <TextBox x:Name="SourceDomain" />

                <TextBlock Text="Target tenant" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Tenant ID" />
                <TextBox x:Name="TargetTenantId" />
                <TextBlock Text="App (client) ID" />
                <TextBox x:Name="TargetClientId" />
                <TextBlock Text="Client secret" />
                <PasswordBox x:Name="TargetClientSecret" />
                <TextBlock Text="Primary domain (e.g. fabrikam.onmicrosoft.com)" />
                <TextBox x:Name="TargetDomain" />

                <TextBlock Text="Workload" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="WorkloadCombo" SelectedIndex="0">
                    <ComboBoxItem Content="Users" />
                    <ComboBoxItem Content="Groups" />
                    <ComboBoxItem Content="Mailboxes" />
                    <ComboBoxItem Content="Files (OneDrive)" />
                    <ComboBoxItem Content="Teams" />
                </ComboBox>

                <TextBlock Text="Files scope — source user UPN (OneDrive only)" Margin="0,8,0,0" />
                <TextBox x:Name="ScopeBox" />

                <CheckBox x:Name="RewriteUpnCheck" Content="Rewrite UPN domain to target" IsChecked="True" Margin="0,10,0,4" />
                <CheckBox x:Name="SkipGuestsCheck" Content="Skip guest users" IsChecked="True" Margin="0,0,0,4" />
                <CheckBox x:Name="ExecuteCheck" Content="Execute (unchecked = dry run)" Margin="0,0,0,8" />

                <Button x:Name="TestButton" Content="Test connections" Height="30" Margin="0,8,0,2" Click="OnTestClick" />
                <Button x:Name="PlanButton" Content="Discover &amp; Plan" Height="34" Margin="0,4" Click="OnPlanClick" />
                <Button x:Name="MigrateButton" Content="Migrate" Height="34" Margin="0,4" Click="OnMigrateClick" />
                <Button x:Name="CancelButton" Content="Cancel" Height="28" Margin="0,2,0,0" Click="OnCancelClick" IsEnabled="{Binding IsBusy}" />
                <Button x:Name="OpenFolderButton" Content="Open reports folder" Height="28" Margin="0,2,0,0" Click="OnOpenFolderClick" />
                <ProgressBar x:Name="BusyBar" Height="6" IsIndeterminate="{Binding IsBusy}" Margin="0,6,0,0" />

                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,10,0,0"
                           Text="Each tenant needs an Azure AD app registration (client id + secret) with admin-consented Graph application permissions. Start with Test connections, then Discover &amp; Plan. Migrate is a dry run until Execute is ticked." />
            </StackPanel>
        </ScrollViewer>

        <!-- Right: results + status -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Plan / Results" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="8" Margin="0,8,0,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
