<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>M365Migrate.App</RootNamespace>
    <AssemblyName>M365Migrate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../M365Migrate.Core/M365Migrate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows DPAPI for encrypting saved profile secrets at rest. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
